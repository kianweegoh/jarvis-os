node_modules/
dist/
.vite/

# databases & indexes
*.db
*.sqlite
*.sqlite3
embeddings/

# os
.DS_Store
Thumbs.db

# raw session transcripts archived by the SessionEnd hook (local safety net,
# may contain anything Claude read — kept out of the committed vault)
vault/daily/sessions/
